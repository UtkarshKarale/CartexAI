# Copy this file to .env and fill in your values.
# .env is gitignored — never commit actual credentials.

# Google OAuth2 credentials (Desktop App type) from Google Cloud Console.
# Enable Gmail API, then create OAuth2 credentials -> Desktop App.
# Register redirect URI: http://localhost:4002/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
